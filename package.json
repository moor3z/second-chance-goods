{
  "name": "second-chance-goods",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev --binding DATA_MODE=demo",
    "dev:live": "wrangler pages dev --binding ALLOW_TEST_SOURCE=1",
    "db:migrate:local": "wrangler d1 execute scg-catalogue --local --file=migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute scg-catalogue --remote --file=migrations/0001_init.sql",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p sync-worker/tsconfig.json --noEmit",
    "test": "node --experimental-sqlite --import tsx --test tests/*.test.ts",
    "ebay:auth": "node scripts/ebay-auth.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.0",
    "fast-xml-parser": "^5.11.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0",
    "wrangler": "^4.144.0"
  }
}
